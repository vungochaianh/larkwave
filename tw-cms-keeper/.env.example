# ── Backend CMS (apihoanam) ──────────────────────────────────────────────────
# REST API base — NO trailing slash. The keeper only ever writes connector
# sessions here (PUT /bitable-sync/:id). No auth token is required.
CMS_API_BASE=https://apihoanam.toolswave.net/api

# ── Lark web session ─────────────────────────────────────────────────────────
# The Lark web origin whose logged-in session the keeper holds alive.
# This is your tenant host (see any Bitable URL: https://<host>/base/...).
LARK_HOST=https://lsgav2gopb4m.sg.larksuite.com

# URL loaded on every keep-alive tick to refresh Lark's own session cookies.
# Default = LARK_HOST root. You may point it at a specific base URL if you want
# the keeper to also re-capture that base's docs-host-id header, e.g.
# KEEPALIVE_URL=https://lsgav2gopb4m.sg.larksuite.com/base/XXXXXXXXXXXXXX
KEEPALIVE_URL=

# ── Timing ───────────────────────────────────────────────────────────────────
# How often to PUSH a fresh session into every connector job (seconds).
REFRESH_INTERVAL_SEC=1800
# How often to reload the Lark page so cookies stay fresh (seconds).
KEEPALIVE_INTERVAL_SEC=600
# How long `login` waits for you to finish signing in (seconds).
LOGIN_TIMEOUT_SEC=300

# ── Browser ──────────────────────────────────────────────────────────────────
HEADLESS=true
# Chromium profile directory (persists cookies between restarts). Relative to
# the project root unless absolute.
PROFILE_DIR=.profile
# Desktop Chrome UA — Lark blocks/renders differently for headless/Electron UAs.
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36

# ── Re-login QR server ───────────────────────────────────────────────────────
# The keeper serves a live self-refreshing QR page at <PUBLIC_URL>/qr for
# re-login when the session expires. Set PUBLIC_URL to the box's reachable
# address so the alert + app can link to it (e.g. your Tailscale IP).
KEEPER_HTTP_PORT=8790
KEEPER_HTTP_HOST=0.0.0.0
# KEEPER_PUBLIC_URL=http://100.100.164.92:8790

# ── Alerts (optional) ────────────────────────────────────────────────────────
# Lark custom-bot webhook to ping when the session drops (includes the /qr link).
ALERT_WEBHOOK=

# Set to 1 to run the full cycle WITHOUT writing to the backend (safe test).
DRY_RUN=0

# ── Multi-account (optional) ─────────────────────────────────────────────────
# Keep SEVERAL Lark accounts alive at once. Leave ACCOUNTS unset to run the single
# account defined by the flat vars above (unchanged behavior). When set, each entry
# gets its OWN browser profile + QR page (<PUBLIC_URL>/qr/<id>) + heartbeat, and its
# session is pushed ONLY to jobs it "owns" via `match` (any of: larkAccountId set by
# the desktop, domains[], appTokens[], jobIds[]). No `match` → defaults to the
# account's own host domain. Log in each account once: `node src/index.js login-qr <id>`.
# ACCOUNTS=[{"id":"hoanam","label":"Hoa Nam","larkHost":"https://lsgav2gopb4m.sg.larksuite.com","profileDir":".profile-hoanam","match":{"domains":["lsgav2gopb4m.sg.larksuite.com"]}},{"id":"kh2","label":"Khách 2","larkHost":"https://yyy.feishu.cn","profileDir":".profile-kh2","match":{"appTokens":["bascnXXXXXXXX"]}}]
