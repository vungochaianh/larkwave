# Toolswave App Builder — production env (server). Copy to repo-root .env on the
# server and fill real values. NEVER commit the filled file.

NODE_ENV=production
PORT=4101

# Postgres (isolated container on 127.0.0.1:5433)
DATABASE_URL=postgresql://toolswave:CHANGE_DB_PASSWORD@127.0.0.1:5433/toolswave?schema=public

# Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# Cloudflare (Pages deploy target)
CF_ACCOUNT_ID=...
CF_API_TOKEN=...
DOMAIN_GOC=toolswave.net

# GitLab (optional; needs glpat- api token to actually push)
GITLAB_TOKEN=
GITLAB_GROUP=toolswave
GITLAB_HOST=https://gitlab.com

# Filesystem
WORKSPACE_DIR=/home/app/toolswave/.workspace
ARTIFACTS_DIR=/home/app/toolswave/.artifacts

# Security
ADMIN_EMAIL=admin@toolswave.net
ADMIN_PASSWORD=CHANGE_ADMIN_PASSWORD
JWT_SECRET=CHANGE_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=12h
ALLOW_REGISTRATION=true
CORS_ORIGINS=https://app.toolswave.net,https://aapp.toolswave.net

# Limits
MAX_CONCURRENT_JOBS=2
COST_LIMIT_USD=5
MAX_FIX_ATTEMPTS=2

# Web (Next.js) — public API base used at build/runtime
NEXT_PUBLIC_API_BASE=https://apia.toolswave.net/v1
