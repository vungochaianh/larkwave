# Per-backend secrets. Copy to <service>/.env (e.g. api/.env) — NOT committed.
# docker-compose loads it via `env_file`. deploy.sh rsyncs it to the server.

# Database
DATABASE_URL=postgres://postgres:change-me@db:5432/app
# or: MONGODB_URI=mongodb://db:27017/app

# Auth / app
JWT_SECRET=change-me
NODE_ENV=production
PORT=3001

# Third-party keys
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
