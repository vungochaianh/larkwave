# Backend (giữ nguyên nếu dùng bản chính thức)
TW_API_BASE=https://api.toolswave.net/v1

# Đăng nhập AS ADMIN (người sở hữu các quyền chia sẻ Trợ lý AI).
# Cách 1: token dài hạn
# TW_ADMIN_TOKEN=eyJ...
# Cách 2: email + mật khẩu (host tự đăng nhập + làm mới token)
TW_ADMIN_EMAIL=admin@example.com
TW_ADMIN_PASSWORD=super-secret

# Claude CLI của admin trên VM này (phải đã `claude` đăng nhập bằng tài khoản admin).
CLAUDE_BIN=claude
# TW_MODEL=            # tuỳ chọn: ép model
TW_POLL_INTERVAL_SEC=5
TW_TURN_TIMEOUT_SEC=120
TW_BATCH=3
