# ============================================================
# TOOLSWAVE APP BUILDER — FILE CẤU HÌNH BÍ MẬT
# Copy file này thành .env rồi điền giá trị. KHÔNG commit .env lên git.
# Đổi token sau này CHỈ cần sửa file này.
# ============================================================

# --- Claude: bộ não sinh spec/code ---
ANTHROPIC_API_KEY=dien-key-claude-moi-vao-day
ANTHROPIC_MODEL=claude-opus-4-8

# --- Cloudflare: deploy web (Pages) + lưu trữ (R2) ---
CF_ACCOUNT_ID=dien-account-id
CF_API_TOKEN=dien-cloudflare-api-token-moi
CF_R2_ACCESS_KEY_ID=dien-r2-access-key
CF_R2_SECRET_ACCESS_KEY=dien-r2-secret-key
CF_R2_ENDPOINT=https://dien-account-id.r2.cloudflarestorage.com
DOMAIN_GOC=toolswave.net

# --- GitLab: nơi lưu code mỗi app ---
GITLAB_TOKEN=dien-gitlab-token-moi
GITLAB_GROUP=toolswave
GITLAB_HOST=https://gitlab.com

# --- Server build/deploy (qua Tailscale) ---
DEPLOY_HOST=100.100.164.92
DEPLOY_USER=app
TAILSCALE_AUTHKEY=dien-tailscale-authkey-moi
TAILSCALE_API_TOKEN=dien-tailscale-api-token-moi

# --- Giới hạn vận hành ---
MAX_FIX_ATTEMPTS=3
COST_LIMIT_USD=5

# --- CMS ---
CMS_PORT=8080
CMS_PASSWORD=dat-mot-mat-khau-dang-nhap-cms
