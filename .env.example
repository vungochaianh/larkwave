# ============================================================
# LARKWAVE — FILE CẤU HÌNH BÍ MẬT (apps/api đọc qua src/config/env.ts)
# Copy file này thành .env rồi điền giá trị. KHÔNG commit .env lên git.
# Danh sách đầy đủ + mặc định: apps/api/src/config/env.ts
# ============================================================

# --- Cơ sở dữ liệu (Postgres RIÊNG cho Larkwave) ---
DATABASE_URL=postgresql://larkwave:doi-mat-khau@localhost:5432/larkwave?schema=public

# --- Bảo mật ---
JWT_SECRET=dat-mot-chuoi-dai-ngau-nhien
ADMIN_EMAIL=admin@toolswave.net
ADMIN_PASSWORD=doi-mat-khau-admin
CORS_ORIGINS=https://lark.toolswave.net,https://cms.lark.toolswave.net
WEB_PUBLIC_URL=https://lark.toolswave.net
PUBLIC_API_URL=https://api.lark.toolswave.net

# --- MAIC: Claude hosted (Trợ lý AI không cần Claude trên máy) ---
MAIC_URL=
MAIC_TOKEN=
MAIC_USD_PER_MTOK=10

# --- Anthropic (tuỳ chọn): trợ lý trợ giúp dự phòng + phân loại báo lỗi ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# --- OpenAI (tuỳ chọn): tạo ảnh AI trong Trợ lý ---
OPENAI_API_KEY=

# --- Lark chạy hộ (LarkHostedRunner) — để trống là TẮT ---
LARK_CREDS_KEY=
LARK_RUNNER_SERVICE_KEY=

# --- Đăng nhập Google / GitLab / GitHub (tuỳ chọn) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.lark.toolswave.net/v1/auth/google/callback
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_REDIRECT=https://api.lark.toolswave.net/v1/auth/gitlab/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT=https://api.lark.toolswave.net/v1/auth/github/callback

# --- SePay (thanh toán chuyển khoản) ---
SEPAY_WEBHOOK_APIKEY=
SEPAY_API_TOKEN=
TW_BANK_BIN=
TW_BANK_ACCOUNT=
TW_BANK_HOLDER=
TW_BANK_NAME=

# --- SMTP (quên mật khẩu) ---
SMTP_USER=
SMTP_PASS=
