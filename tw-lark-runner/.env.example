# ── Kết nối Lark (App Secret nằm TRÊN VM NÀY, không lên máy chủ Larkwave) ────
# Lấy ở Lark Developer Console → app của bạn → Credentials & Basic Info.
# Dùng ĐÚNG app mà bạn đã kết nối trong Lark × Agents trên máy tính, nếu không
# VM sẽ không thấy các Base đã đăng ký.
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Tài khoản Larkwave ──────────────────────────────────────────────────────
# Token đăng nhập của bạn. VM dùng nó để: tải lịch, chạy agent bằng gói token của
# bạn, và giành quyền chạy lịch (chống chạy trùng với app desktop).
# Lấy: mở app desktop → Cài đặt → Tài khoản → Sao chép token.
LARKWAVE_TOKEN=

# Chỉ đổi nếu bạn tự dựng máy chủ riêng.
LARKWAVE_API=https://api.toolswave.net/v1

# Nhãn hiện ở giao diện khi VM đang giữ quyền chạy lịch.
RUNNER_LABEL=VM chạy lịch

# Múi giờ — QUYẾT ĐỊNH lịch "mỗi ngày 9h" là 9h ở đâu. Đặt sai là lịch chạy lệch giờ.
TZ=Asia/Ho_Chi_Minh
