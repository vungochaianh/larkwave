# ── Chế độ CHẠY HỘ ───────────────────────────────────────────────────────────
# Tiến trình này gánh lịch tự động hoá cho NHIỀU người dùng Larkwave. Khoá Lark KHÔNG nằm ở
# đây — nó lấy từ máy chủ, từ những người đã tự bật "Để Larkwave chạy lịch hộ" trong app.
#
# Đọc chú thích ở model `LarkHostedRunner` (apps/api/prisma/schema.prisma) trước khi dựng cái
# này ở đâu: nó là chỗ duy nhất trong hệ thống cất app_secret Lark.
MODE=hosted

# Phải TRÙNG `LARK_RUNNER_SERVICE_KEY` trong .env của API. Sai là máy chủ trả 404.
LARK_RUNNER_SERVICE_KEY=

LARKWAVE_API=https://api.toolswave.net/v1

# Múi giờ — QUYẾT ĐỊNH lịch "mỗi ngày 9h" là 9h ở đâu.
TZ=Asia/Ho_Chi_Minh
