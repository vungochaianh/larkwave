// Larkwave App Builder — data model.
// Multi-tenant: users own apps; apps accumulate builds; successful builds
// produce versioned deployments. Indexed for list/filter at scale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Track {
  web
  mobile
  extension
  desktop
  game
}

enum Role {
  admin
  user
}

enum UserStatus {
  active
  suspended
}

enum AppStatus {
  draft
  building
  live
  failed
  archived
  suspended
}

enum BuildStatus {
  queued
  running
  // Non-terminal pause: the design Blueprint has been generated and the build
  // is waiting for the user to approve it at the gate before codegen runs.
  awaiting_approval
  succeeded
  failed
  canceled
}

// Kind of backend an app targets. `static` (default) = classic SPA on Cloudflare
// Pages — fully backward-compatible. `fullstack` is reserved for v1 (SPA +
// Pages Functions + per-app D1 database).
enum AppBackendKind {
  static
  fullstack
}

enum DeploymentStatus {
  live
  superseded
  failed
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String     @default("")
  avatarUrl    String?
  role         Role       @default(user)
  status       UserStatus @default(active)
  /// Session revocation counter. Every issued JWT carries the value at sign time; the
  /// auth guard rejects a token whose value no longer matches. Bumped on password change
  /// so a password change invalidates every existing session (device), while an unchanged
  /// password keeps sessions valid indefinitely (tokens are long-lived by design).
  /// Additive Int with a default → `prisma db push` needs no destructive flag.
  tokenVersion Int        @default(0)
  /// Danh tính từ một hệ NGOÀI, dạng `<hệ>:<id>` — vd `fbinbox:1234`.
  ///
  /// Khoá liên kết cho đường cấp tài khoản service-to-service. Liên kết theo TRƯỜNG NÀY chứ
  /// KHÔNG theo email, và đó là cả điểm mấu chốt: nếu liên kết theo email thì một máy chủ ngoài
  /// chỉ cần khai "người dùng của tôi có email admin@..." là nhận được token của tài khoản đó.
  /// Nullable + @unique → `prisma db push` thêm được mà không mất dữ liệu (xem ghi chú deviceLimit).
  externalId   String?    @unique
  /// Per-account device-cap override. null → the default MAX_DEVICES (3). A positive
  /// value sets a custom cap; 0 (or negative) means UNLIMITED devices (eviction is
  /// skipped). Nullable Int → additive `prisma db push`, no data loss.
  deviceLimit  Int?
  // Subscription + monthly CREDIT usage (see src/billing/plans.ts for the catalog).
  // quotaUsed now holds CREDITS USED this month; quotaResetAt is the reset boundary.
  plan         String     @default("free")
  /// Whether this user appears in the public "discover users" directory + can be
  /// found by others to friend. false = private (still reachable by exact email).
  discoverable Boolean    @default(true)
  quotaUsed    Int        @default(0)
  quotaResetAt DateTime?
  /// Precise instant the CURRENT credit window was established (set on every reset
  /// AND every plan grant). Unlike quotaResetAt (a month boundary that two windows
  /// in the same month share), this is monotonic/unique — used as the refund window
  /// key so a same-month renewal can't be mistaken for the original window.
  quotaWindowAt DateTime?
  // Per-user OAuth access tokens used to read/push the user's own git repos.
  // Stored as-is for now (TODO: encrypt at rest). Never exposed in API responses.
  gitlabToken    String?
  gitlabUsername String?
  // GitLab access tokens expire (~2h); store the refresh token + expiry so the
  // connection auto-renews instead of forcing the user to re-authorize each visit.
  gitlabRefreshToken   String?
  gitlabTokenExpiresAt DateTime?
  githubToken    String?
  githubUsername String?
  /// Public maker-profile handle (/u/{handle}). Lazily generated on first need.
  /// Uniqueness is enforced at the app layer (ensureIdentity) — NOT a DB @unique,
  /// so adding it via `prisma db push` needs no destructive --accept-data-loss flag.
  handle       String?
  /// Referral: this user's own shareable code, and who referred them.
  referralCode String?
  referredById String?
  /// Ad-hoc credits ADDED to the monthly plan allowance (signup grant, referral
  /// rewards). available = planCredits + bonusCredits - quotaUsed.
  bonusCredits Int        @default(0)
  /// Dung lượng lưu trữ MUA THÊM (MB), cộng vào phần được tặng theo gói
  /// (PlanCatalogEntry.storageMb).
  ///
  /// Tách khỏi hạn mức token vì bản chất khác nhau: token tiêu hết mỗi tháng rồi làm mới, còn
  /// dung lượng TÍCH LUỸ — video và mã nguồn nằm đó tới khi người dùng xoá.
  storageBonusMb Int      @default(0)
  /// Hạn của phần mua thêm. KHÁC bonusCredits (cộng vĩnh viễn): đây là tiền THUÊ CHỖ theo tháng,
  /// hết hạn mà không gia hạn thì phần mua thêm không còn tính nữa. Null = chưa từng mua.
  ///
  /// Cố ý KHÔNG tự xoá dữ liệu khi hết hạn — chỉ ngừng cộng thêm chỗ. Xoá dữ liệu người dùng vì
  /// một khoản thanh toán trễ là thứ không được phép làm âm thầm.
  storageBonusUntil DateTime?
  /// True once the user who referred this account has been rewarded (anti-abuse:
  /// the referrer is paid only on this account's FIRST successful build).
  referralRewarded Boolean @default(false)
  /// Per-user webhook token (sha256 hex) for the external `POST /v1/agent/webhook`
  /// enqueue endpoint. Nullable column → additive `prisma db push`, no data loss.
  agentTokenHash String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  apps                App[]
  builds              Build[]
  payments            Payment[]
  passwordResetTokens PasswordResetToken[]
  sentFriendRequests     Friendship[] @relation("FriendRequester")
  receivedFriendRequests Friendship[] @relation("FriendAddressee")
  sentMessages           Message[]    @relation("MsgSender")
  receivedMessages       Message[]    @relation("MsgRecipient")
  appMemberships         AppMember[]
  uploads                Upload[]
  feedback               Feedback[]
  notifications          Notification[]
  blogPosts              BlogPost[]
  blogComments           BlogComment[]
  socialPosts            SocialPost[]
  socialPostLikes        SocialPostLike[]
  socialComments         SocialComment[]
  referredBy             User?        @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals              User[]       @relation("Referrals")
  following              Follow[]     @relation("Following")
  followers              Follow[]     @relation("Followers")
  larkBackup             LarkBackup?
  larkShares             LarkShare[]
  larkGrantsOwned        LarkGrant[]   @relation("LarkGrantOwner")
  larkGrantsReceived     LarkGrant[]   @relation("LarkGrantGrantee")
  larkGrantInvites       LarkGrantInvite[]
  larkRunnerLease        LarkRunnerLease?
  larkHostedRunner       LarkHostedRunner?
  larkGrantCalls         LarkGrantCall[]
  devices                AgentDevice[] @relation("UserDevices")
  remoteTasks            RemoteTask[]  @relation("UserRemoteTasks")
  agentWebhookTokens     AgentWebhookToken[]
  agentConversations     AgentConversation[]
  agentChatConversations AgentChatConversation[]
  agentChatProjects      AgentChatProject[]
  assistantShares        AssistantShare[]
  videoProjects          VideoProject[]
  pictureProjects        PictureProject[]
  blogProjects           BlogProject[]
  marketingSchedules     MarketingSchedule[]
  telegramDelivery       TelegramDeliveryConfig?
  telegramChannels       TelegramChannel[]
  categories             Category[]
  telegramBindings       TelegramBinding[]
  telegramLinkCodes      TelegramLinkCode[]
  loginSessions          LoginSession[] @relation("UserLoginSessions")
  skills                 Skill[]
  scheduledTasks         ScheduledTask[]
  artifacts              Artifact[]
  apiKeys                ApiKey[]
  runnerErrors           RunnerError[]
  storeOrders            Order[]
  entitlements           Entitlement[]
  listingsForSale        Listing[]     @relation("ListingSeller")

  @@index([role])
  @@index([createdAt])
  @@index([referredById])
  @@index([handle])
  @@index([referralCode])
}

/// A user-issued Developer API key (for the public API). The raw key is shown ONCE at creation;
/// only its SHA-256 hash is stored. Auth via `Authorization: Bearer tw_...` on /v1/pub/* endpoints.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// Non-secret display prefix, e.g. "tw_live_a1b2c3" (first chars of the key).
  prefix     String
  /// SHA-256 hex of the FULL key — the only stored form.
  hash       String    @unique
  /// PHẠM VI: mảng JSON các quyền ("apps:read" | "apps:write" | "builds:read" | "account:read").
  ///
  /// Rỗng = TOÀN QUYỀN, và đó là cách duy nhất giữ tương thích với các key đã phát trước khi có
  /// trường này — đổi mặc định thành "không quyền gì" sẽ làm chết mọi tích hợp đang chạy mà không
  /// báo trước. Key TẠO MỚI thì giao diện luôn gửi phạm vi cụ thể.
  scopes     Json      @default("[]")
  /// Trần số lượt gọi mỗi THÁNG DƯƠNG LỊCH cho riêng key này. null = không giới hạn riêng (vẫn
  /// chịu hạn mức token của cả tài khoản).
  ///
  /// Đây là hàng rào theo KEY, khác với hạn mức % của tài khoản: một key lộ ra ngoài có thể đốt
  /// sạch hạn mức tháng của cả tài khoản trước khi ai kịp nhận ra.
  monthlyLimit Int?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  calls      ApiKeyCall[]

  @@index([userId])
}

/// Một lượt gọi qua Developer API — sổ dùng của TỪNG key.
///
/// Vì sao ghi từng lượt thay vì chỉ đếm: khi một key bỗng tốn gấp mười, câu hỏi đầu tiên là "gọi
/// cái gì, lúc nào, có lỗi không". Một con số đếm không trả lời được câu nào trong ba câu đó.
///
/// Giữ gọn: chỉ tuyến đường + mã trạng thái + thời điểm. KHÔNG lưu thân yêu cầu — nó chứa prompt
/// của người dùng, và một sổ nhật ký không phải chỗ để dữ liệu đó nằm lại.
model ApiKeyCall {
  id        String   @id @default(cuid())
  keyId     String
  key       ApiKey   @relation(fields: [keyId], references: [id], onDelete: Cascade)
  /// Ví dụ "POST /pub/apps". Đã chuẩn hoá (id trong đường dẫn thay bằng ":id") để gom nhóm được.
  route     String
  status    Int
  /// Thời gian xử lý, mili giây — để thấy lượt nào chậm bất thường.
  ms        Int      @default(0)
  createdAt DateTime @default(now())

  @@index([keyId, createdAt])
}

/// Một lỗi RUNNER mà người dùng gặp trên MÁY HỌ (Claude CLI hỏng xác thực/hết credit…) hoặc khi
/// hỏi qua "Gói Larkwave" (MAIC). Các lượt chạy CLI diễn ra cục bộ nên máy chủ KHÔNG tự thấy; bản
/// ghi này do chính giao diện gửi về để người vận hành có một bảng "lỗi runner gần đây" ở /admin,
/// thay vì chỉ biết khi người dùng gửi ảnh.
model RunnerError {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Runner gặp lỗi: "claude" | "toolswave" (MAIC) | "openai" | … (bí danh người dùng chọn).
  runner    String
  /// Model đang chọn lúc lỗi, nếu biết (vd "claude-haiku-4-5").
  model     String?
  /// Loại lỗi đã phân: auth | credit | context | overload | rate_limit | other.
  kind      String
  /// Màn gặp lỗi: "lark" | "general" (Trợ lý AI chung) | "remote" …
  surface   String   @default("general")
  /// Trích nội dung lỗi (đã cắt ≤1000 ký tự) để biết cụ thể là gì.
  message   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@index([createdAt])
}

/// A LOGIN SESSION = one signed-in device (phone / computer). Enforces the per-account
/// device cap (max 3): a 4th login revokes the least-recently-seen session, logging that
/// device out. The JWT carries this row's id as `sid`; the auth guard rejects a token whose
/// session is revoked or gone. Distinct from AgentDevice (a registered remote-run machine).
/// Additive model → `prisma db push` needs no destructive flag.
model LoginSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation("UserLoginSessions", fields: [userId], references: [id], onDelete: Cascade)
  /// phone | desktop | web — derived from the user-agent, shown in the device manager.
  kind       String    @default("desktop")
  /// Friendly label, e.g. "Chrome · macOS" or "App Larkwave".
  label      String    @default("")
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  /// Refreshed (throttled) by the auth guard so eviction targets the least-recently-used device.
  lastSeenAt DateTime  @default(now())
  /// Set when this session is revoked (evicted by the cap, or logged out from the device manager).
  revokedAt  DateTime?

  @@index([userId, revokedAt, lastSeenAt])
}

/// A user's server-side SKILL for the hosted "Trợ lý AI" (MAIC). Unlike the desktop's
/// per-CLI local skill files, these live server-side per account and every ENABLED skill is
/// injected into the hosted assistant's system prompt. `scope` mirrors the desktop runner ids
/// (claude|grok|gemini|codex) for organization + future desktop sync; the hosted assistant
/// applies all enabled skills regardless of scope. Additive model → `prisma db push` safe.
model Skill {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  /// When to use this skill (the trigger the assistant matches on) — like a Claude Skill's
  /// `description`. Shown on the card + injected so the model knows WHEN to apply the skill.
  description  String   @default("")
  /// The full editable instruction body (markdown) — WHAT to do when the skill applies.
  instructions String
  /// Enabled = injected into the hosted assistant's system prompt; disabled = library only.
  enabled      Boolean  @default(true)
  /// Runner ids this skill is tagged for (claude|grok|gemini|codex). Empty = all. Organizational
  /// on web; the hosted assistant applies every enabled skill.
  scope        String[]
  /// Free-form user labels for filtering ("Làm app", "Lark", …).
  tags         String[]
  /// Optional slash-command shortcut, stored WITHOUT the leading "/" (e.g. "sieu-ba" → the user
  /// types "/sieu-ba" in a chat composer to force this skill for that turn, even if it is
  /// disabled). Empty = no shortcut. Uniqueness per user is enforced in the service, not the DB,
  /// so the column stays additive → `prisma db push` safe.
  command      String   @default("")
  /// Attached reference files (like Claude Skills bundle files) — an array of
  /// { name, description, content } (text content). Injected into the hosted assistant
  /// alongside the instructions when the skill is enabled. Nullable Json → additive db push.
  attachments  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

/// A recurring "Scheduled task" (like claude.ai/scheduled-task): the hosted assistant (MAIC)
/// runs `prompt` on a cron schedule and delivers the result (in-app notification + stored
/// lastResult). Additive model → `prisma db push` safe.
model ScheduledTask {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// The instruction the assistant runs each time.
  prompt     String
  /// 5-field cron expression (minute hour day month weekday), interpreted in `timezone`.
  cron       String
  timezone   String    @default("Asia/Ho_Chi_Minh")
  enabled    Boolean   @default(true)
  /// 'notification' (in-app) | 'telegram' (also push to the user's linked chat) | 'both'.
  deliver    String    @default("notification")
  nextRunAt  DateTime?
  lastRunAt  DateTime?
  /// Last run's answer (so the user can read it in-app) + last error (if any).
  lastResult String?   @db.Text
  lastError  String?
  runCount   Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([enabled, nextRunAt])
  @@index([userId, createdAt])
}

/// A saved "Artifact" (like claude.ai/artifacts): a standalone HTML / markdown / code / SVG
/// output the user keeps in a library and can share via a public slug. Additive model.
model Artifact {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String   @default("")
  /// html | markdown | code | svg
  kind       String   @default("html")
  /// For kind = code: the language for syntax highlighting.
  language   String   @default("")
  content    String   @db.Text
  /// private | public — public artifacts are readable at /a/<slug> with no login.
  visibility String   @default("private")
  slug       String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, updatedAt])
}

/// Remote agent relay — a registered desktop ("Máy của tôi") that holds an SSE
/// command stream open and runs the user's enqueued RemoteTasks. One row per
/// machine (matched by userId + name). `lastSeenAt` is refreshed on every
/// heartbeat while connected; "online" = within the heartbeat window.
model AgentDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("UserDevices", fields: [userId], references: [id], onDelete: Cascade)
  name       String
  platform   String   @default("")
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  /// JSON array of this device's local apps (id/name/status/url/updatedAt), pushed by
  /// the desktop so the phone can list them + send follow-up edits. Refreshed on sync.
  appsJson     String?   @db.Text
  appsSyncedAt DateTime?

  tasks RemoteTask[]

  @@index([userId])
}

/// A NAMED webhook token (e.g. one per project) for the external `POST /v1/agent/webhook`
/// enqueue endpoint. Multiple per user; all route to the user's online device (label model).
/// Additive table → `prisma db push` is safe. Legacy User.agentTokenHash stays as a fallback.
model AgentWebhookToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String    @unique
  tokenPrefix String    @default("")
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  /// Optional OUTBOUND notify target: when a task from this token finishes, push a
  /// summary here. Either a Lark custom-bot webhook URL and/or a bound Telegram chat.
  notifyLarkWebhookUrl String?
  notifyTelegramChatId String?

  @@index([userId])
}

/// A Telegram chat bound to a Larkwave user. Messages in a bound chat trigger a
/// remote-run task; the task replies back into the same chat. One row per chat.
/// The platform Telegram bot (env TELEGRAM_BOT_TOKEN) is shared; binding is what
/// scopes a chat to a user. Additive → `prisma db push` is safe.
model TelegramBinding {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId    String   @unique
  chatTitle String?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A one-time code a user generates in the app, then sends to the bot as
/// `/start <code>` to bind the current Telegram chat to their account. Short-lived
/// (consumed on use; the receiver ignores codes older than ~15 min).
model TelegramLinkCode {
  code      String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A coding task enqueued from the phone, pushed to an online AgentDevice over
/// SSE, run locally by the desktop, with progress POSTed back as RemoteTaskEvents.
model RemoteTask {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("UserRemoteTasks", fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String?
  device     AgentDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  runner     String   @default("claude")
  model      String?
  prompt     String   @db.Text
  status     String   @default("queued")
  appId      String?
  result     String?  @db.Text
  error      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?
  /// Lần cuối tác vụ này được ĐẨY xuống desktop. Khác `startedAt` (desktop báo đã chạy):
  /// dùng để không gửi lại cùng một tác vụ mỗi lần SSE nối lại — xem `flushQueued`.
  deliveredAt DateTime?

  /// Where this task was triggered from: phone | webhook | telegram | lark.
  source     String   @default("phone")
  /// OUTBOUND reply/notify targets carried from the trigger (chat to reply into,
  /// or the token's configured notify target). Sent when the task reaches a terminal state.
  notifyLarkWebhookUrl String?
  notifyTelegramChatId String?
  /// Set once, atomically, when the terminal notify is claimed — guards against a
  /// duplicate notification when two of the user's desktops both post a terminal event.
  notifiedAt DateTime?

  /// The named conversation this task belongs to (null = the default/unfiled thread).
  conversationId String?
  conversation   AgentConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  events RemoteTaskEvent[]

  @@index([userId, status, createdAt])
  @@index([conversationId])
}

/// A named conversation on the "Máy của tôi" page — groups RemoteTasks into a
/// switchable thread (like a chat sidebar). Additive → `prisma db push` is safe.
model AgentConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Hội thoại mới")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks RemoteTask[]

  @@index([userId, updatedAt])
}

/// "Trợ lý AI" chat history synced across the user's devices + web (desktop → server → web,
/// bidirectional). One row per conversation: meta + the full TEXT-ONLY body (Item[]). `clientTs`
/// (client updatedAt in ms) is the merge key — newest wins. Images are stripped before persist, so
/// bodies stay small. Mirrors the desktop AgentChat localStorage index/body model.
model AgentChatConversation {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("")
  sessionId String   @default("")
  projectId String?
  pinned    Boolean  @default(false)
  clientTs  Float    @default(0)
  body      Json     @default("[]")
  /// When set, this conversation is PUBLIC (read-only transcript) at /s/<shareSlug>. Null = private.
  shareSlug String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, clientTs])
}

/// A PUBLIC, chat-able link to a user's hosted "Trợ lý AI". Anyone with /g/<slug> can chat; the
/// turn runs on hosted MAIC and is metered to the OWNER's % budget (read-only, rate-limited).
model AssistantShare {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  slug         String   @unique
  label        String   @default("")
  enabled      Boolean  @default(true)
  /// Optional: inject this AgentChatProject's instructions (+ the owner's enabled skills).
  projectId    String?
  turnsPerHour Int      @default(20)
  turnsPerDay  Int      @default(100)
  usesTotal    Int      @default(0)
  lastUsedAt   DateTime?
  createdAt    DateTime @default(now())
  hits         AssistantShareHit[]

  @@index([ownerId])
}

/// An AI-generated video (Video Studio): template + topic + ElevenLabs voice → rendered mp4.
model VideoProject {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String   @default("")
  /// game | pixel | draw
  template    String   @default("draw")
  /// 9:16 | 16:9
  aspect      String   @default("9:16")
  /// colour palette id (auto | sunset | ocean | forest | berry | pastel | mono | neon | gold)
  palette     String   @default("auto")
  /// mascot character id (none | sticky | bloop | robo)
  character   String   @default("none")
  /// optional Category (danh mục) → routes Telegram delivery to that category's channels
  categoryId  String?
  topic       String   @default("") @db.Text
  voiceId     String   @default("")
  script      String   @default("") @db.Text
  /// draft | rendering | done | error
  status      String   @default("draft")
  /// progress stage: script | voice | scene | render
  stage       String   @default("")
  audioUrl    String   @default("")
  videoUrl    String   @default("")
  /// The last generated seekable scene HTML — kept so a refine can EDIT the previous scene.
  sceneHtml   String   @default("") @db.Text
  /// Poster frame (PNG) extracted from the video — sent to Telegram before the video.
  thumbnailUrl String  @default("")
  /// Short social caption (for the Telegram message).
  caption     String   @default("") @db.Text
  durationSec Float    @default(0)
  error       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
}

/// Make Picture — an AI-generated image post: caption + a designed poster (HTML → PNG).
model PictureProject {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("")
  /// quote | announce | tip | promo (see post/templates)
  template  String   @default("quote")
  /// 1:1 | 4:5 | 16:9
  aspect    String   @default("1:1")
  /// colour palette id (auto | sunset | ocean | forest | berry | pastel | mono | neon | gold)
  palette   String   @default("auto")
  /// mascot character id (none | sticky | bloop | robo)
  character String   @default("none")
  /// number of images in this post (1 = single, >1 = carousel / nhiều ảnh)
  count     Int      @default(1)
  /// optional Category (danh mục) → routes Telegram delivery to that category's channels
  categoryId String?
  topic     String   @default("") @db.Text
  caption   String   @default("") @db.Text
  /// first/cover image (also the thumbnail); kept for backward-compat + single-image posts
  imageUrl  String   @default("")
  /// ALL images of the post (carousel). imageUrls[0] === imageUrl.
  imageUrls String[] @default([])
  /// The last generated poster HTML — kept so a refine can EDIT the previous poster.
  html      String   @default("") @db.Text
  status    String   @default("draft")
  /// progress stage: caption | image
  stage     String   @default("")
  error     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

/// Make Blog — an AI-written article: title + body (markdown) + excerpt + optional cover (HTML → PNG).
model BlogProject {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("")
  /// howto | listicle | news | story (see blog/templates)
  template  String   @default("howto")
  /// colour palette id for the cover image (auto | sunset | ocean | ... | gold)
  palette   String   @default("auto")
  /// mascot character id for the cover (none | sticky | bloop | robo)
  character String   @default("none")
  /// number of inline illustration images to generate in the body (0–6)
  count     Int      @default(3)
  /// optional Category (danh mục) → routes Telegram delivery to that category's channels
  categoryId String?
  topic     String   @default("") @db.Text
  /// short excerpt used as the Telegram caption
  caption   String   @default("") @db.Text
  body      String   @default("") @db.Text
  coverUrl  String   @default("")
  status    String   @default("draft")
  /// progress stage: write | cover
  stage     String   @default("")
  error     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

/// A recurring job that auto-generates a fresh Marketing item (video|picture|blog) and sends it to
/// the user's configured Telegram (TelegramDeliveryConfig) on a cron schedule. Generic across kinds.
model MarketingSchedule {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// video | picture | blog
  kind           String    @default("video")
  title          String    @default("")
  template       String    @default("")
  /// aspect (video/picture); ignored for blog
  aspect         String    @default("9:16")
  /// colour palette id (auto | sunset | ... | gold)
  palette        String    @default("auto")
  /// mascot character id (none | sticky | bloop | robo)
  character      String    @default("none")
  /// number of images per post (picture carousel); ignored for video/blog
  count          Int       @default(1)
  /// optional Category (danh mục) → routes Telegram delivery to that category's channels
  categoryId     String?
  voiceId        String    @default("")
  topic          String    @default("") @db.Text
  /// 5-field cron (minute hour day month weekday), interpreted in `timezone`.
  cron           String
  timezone       String    @default("Asia/Ho_Chi_Minh")
  /// Explicit Telegram chat id override; null → use TelegramDeliveryConfig.chatId.
  telegramChatId String?
  /// blog only: also publish each generated post to the PUBLIC site blog (/blog/:slug).
  /// Defaults to false on purpose — an existing schedule must not start publishing in public
  /// because of a deploy. The owner opts in per schedule.
  publishToBlog  Boolean   @default(false)
  enabled        Boolean   @default(true)
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  lastItemId     String?
  lastError      String?   @db.Text
  runCount       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([enabled, nextRunAt])
  @@index([userId, createdAt])
}

/// Version/commit history for a Marketing item (video|picture|blog): the initial 'create' + every
/// 'fix' (refine), each snapshotting the result so a version can be viewed or restored. projectId is
/// polymorphic (points at VideoProject/PictureProject/BlogProject) so there's no FK — the owning
/// service deletes these when the project is removed.
model MarketingEdit {
  id           String   @id @default(cuid())
  projectId    String
  userId       String
  /// video | picture | blog
  kind         String
  /// 'create' | 'fix' | 'redo'
  action       String   @default("fix")
  /// the fix prompt (or the topic, for 'create')
  instruction  String   @default("") @db.Text
  title        String   @default("")
  caption      String   @default("") @db.Text
  /// snapshot of the primary media: videoUrl / imageUrl / coverUrl
  mediaUrl     String   @default("")
  thumbnailUrl String   @default("")
  /// snapshot of the text artifact: script (video) / html (picture) / body (blog) — for restore
  extra        String   @default("") @db.Text
  durationSec  Float    @default(0)
  createdAt    DateTime @default(now())

  @@index([projectId, createdAt])
}

/// Per-user Telegram delivery config (their own bot). Bot token is AES-encrypted at rest.
model TelegramDeliveryConfig {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// encryptJson({ botToken }) — never returned to the client.
  botTokenEnc String?
  chatId      String?
  threadId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// One of the user's Telegram destinations (own bot + chat/channel). Multiple per user; a Category
/// routes its content to one or more of these. (TelegramDeliveryConfig above is the legacy single one.)
model TelegramChannel {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String     @default("")
  /// encryptJson({ botToken }) — never returned to the client.
  botTokenEnc String?
  chatId      String?
  threadId    String?
  categories  Category[] @relation("CategoryChannels")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
}

/// A content category (danh mục), shared across video/picture/blog. Picking a category on a piece of
/// content routes its Telegram delivery to that category's TelegramChannels (many-to-many).
model Category {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String            @default("")
  channels  TelegramChannel[] @relation("CategoryChannels")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId])
}

/// One anonymous use of a public assistant link — for per-slug / per-IP rate limiting.
model AssistantShareHit {
  id        String   @id @default(cuid())
  shareId   String
  share     AssistantShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([shareId, createdAt])
}

/// A ChatGPT-style "Project" (folder) grouping AgentChat conversations. Small; the whole set is
/// replaced per user on change.
model AgentChatProject {
  id     String @id
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String @default("")
  ord    Int    @default(0)
  /// Custom instructions for THIS project (like Claude Projects) — injected into the hosted
  /// assistant's system prompt for every conversation in the project. Additive, default "".
  instructions String @default("")

  @@index([userId])
}

/// One streamed progress event of a RemoteTask (log/stage/status/progress/
/// result/error). `payload` is the desktop BuildEvent as-is, replayed on detail.
model RemoteTaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  task      RemoteTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

/// Maker social graph: `follower` follows `following`. Powers the activity feed
/// + follower counts on public maker profiles.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

/// In-app notification (realtime via SSE). Created when something relevant to the
/// user happens (new DM, feedback triaged, build finished). `link` deep-links to
/// the content so clicking jumps straight there.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "message" | "feedback" | "build" | "system"
  type      String
  title     String
  body      String?  @db.Text
  /// Internal path to navigate to on click, e.g. "/apps/<id>" | "/reports" | "/friends?chat=<id>".
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

/// In-app error / bug report submitted by a user from any page. Admins triage +
/// resolve these in /admin/feedback. `context` holds page URL + captured logs.
model Feedback {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The user's description of the bug/error.
  message    String   @db.Text
  /// Page URL where it was reported.
  url        String?
  /// { userAgent, logs: string[] } — recent console errors + environment.
  context    Json?
  /// Uploaded attachments: [{ id, name, kind, mime, size }].
  attachments Json?
  /// "open" | "resolved" | "duplicate" | "rejected".
  status     String   @default("open")
  /// Bug-bounty triage: "low" | "medium" | "high" | "critical" (null until triaged).
  severity   String?
  /// Tester points awarded for this report (0 for duplicates/rejected).
  points     Int      @default(0)
  /// Monetary reward in VND the admin grants for this report.
  rewardVnd  Int      @default(0)
  /// Whether the reward has been paid out, and when.
  rewardPaid   Boolean   @default(false)
  rewardPaidAt DateTime?
  /// If this is a duplicate, points go to the FIRST reporter (the canonical row).
  duplicateOfId String?
  duplicateOf   Feedback?  @relation("FeedbackDup", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    Feedback[] @relation("FeedbackDup")
  adminNote  String?  @db.Text
  resolvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@index([duplicateOfId])
}

// A file attached to a build conversation (design mockups, code, specs…). Images
// are stored base64 (fed to Claude vision); text-like files store extracted text
// (appended to the prompt). Kept small (size-capped at upload).
model Upload {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  mime      String
  kind      String // image | text | pdf
  /// base64 (image/pdf) or raw utf8 text (text; incl. extracted Office docs).
  data      String   @db.Text
  /// Original file bytes, base64 — ONLY for kinds where `data` is not the original (office/text,
  /// where `data` holds extracted text). Null for image/pdf: `data` already IS the original, and
  /// storing it twice would double the row for the largest files. Null on rows created before
  /// this column existed — those can be previewed but not downloaded, and the API says so.
  rawData   String?  @db.Text
  size      Int      @default(0)
  /// What this upload is FOR: 'chat' | 'feedback' | 'marketing' | 'build' | null (unknown/legacy).
  /// The retention job purges ONLY 'chat'. Anything else — a bug-report screenshot an admin
  /// re-reads months later, a marketing source image, a build reference — is still being read by
  /// another feature long after 30 days, so a blanket age rule would silently destroy it. Null
  /// means "not tagged", which is deliberately the KEEP side of the fence.
  purpose   String?
  createdAt DateTime @default(now())
  /// Set when the 30-day retention job deleted the blob. The row SURVIVES as a tombstone so an old
  /// conversation can say "removed because it expired" instead of the indistinguishable "not found".
  purgedAt  DateTime?

  @@index([ownerId])
  @@index([purpose, purgedAt, createdAt])
}

// Project collaboration: a user invited to someone else's app. The app's owner
// is implicit; members are 'editor' (can iterate/build) or 'viewer' (read-only).
model AppMember {
  id        String   @id @default(cuid())
  appId     String
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("editor") // editor | viewer
  createdAt DateTime @default(now())

  @@unique([appId, userId])
  @@index([userId])
}

// Social graph: a directed friend request that becomes a mutual friendship once
// `status` = 'accepted'. Uniqueness is per ordered (requester, addressee) pair.
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User     @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // pending | accepted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

// 1:1 direct message between two users (must be friends to send). `readAt` is
// set when the recipient opens the thread.
model Message {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("MsgSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("MsgRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String    @db.Text
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

// Single-use password OTP. Only the sha256 HASH of the 6-digit code is stored
// (in `tokenHash`); the raw code lives only in the emailed message. Codes expire
// after 10 minutes, allow up to 5 wrong `attempts`, and are marked `usedAt` once
// consumed. Used for both forgot-password (public) and change-password (logged in).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model App {
  id                  String    @id @default(cuid())
  ownerId             String
  owner               User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                String
  slug                String    @unique
  track               Track     @default(web)
  description         String    @default("") @db.Text
  status              AppStatus @default(draft)
  /// Admin moderation: reason the app was suspended (null unless suspended).
  suspendReason       String?   @db.Text
  pagesProject        String?   @unique
  currentUrl          String?
  currentDeploymentId String?
  /// Kind of backend this app targets (`static` default; `fullstack` is v1).
  backendKind         AppBackendKind @default(static)
  /// Whether the app includes an admin/CMS area (implies full-stack).
  cms                 Boolean   @default(false)
  /// User-chosen concrete features (shared.AppFeatureSpec): dark mode, languages,
  /// blog, auth, payments… Persisted so iterate/edit preserves them; injected into
  /// codegen so the first build includes them. Null = baseline defaults.
  featureSpec         Json?
  /// Public website URL the app was/should be CLONED from. When set, the pipeline
  /// fetches it and feeds the page's layout/copy/colours/images to codegen as a
  /// faithful "rebuild this site" reference. Null = no clone source.
  sourceUrl           String?
  /// Last APPROVED design Blueprint (shared.Blueprint payload). Null until first approve.
  blueprint           Json?
  /// Per-app SEO & GEO config (shared.AppSeo): meta/OG tags + sitemap/robots toggles.
  /// Applied to the deployed index.html at deploy time. Null = sensible defaults.
  seo                 Json?
  /// Per-app secrets/env vars — an AES-256-GCM-ENCRYPTED JSON map {KEY:value}.
  /// Set as Cloudflare Pages env vars at deploy so Functions read env.KEY. Null = none.
  secretsEnc          String?   @db.Text
  /// Full-stack apps: the Cloudflare D1 database uuid bound to this app (null = static).
  d1DatabaseId        String?
  /// Whether the D1 schema (schema.sql) has been applied — guards one-time seeding.
  d1Ready             Boolean   @default(false)
  /// Git import: which provider this app was imported from ('gitlab'|'github').
  gitProvider         String?
  /// Full repo path (e.g. 'user/repo') the app was imported from / pushes back to.
  gitRepo             String?
  /// Branch to read from / commit back to.
  gitBranch           String?   @default("main")
  /// True once this app was imported from an external git repo.
  gitImported         Boolean   @default(false)
  /// Persisted .toolswave build/deploy config (shared.BuildConfig) for an imported,
  /// directly-buildable repo. Reused on every re-run/redeploy so no LLM/tokens are
  /// needed. Null = derive on next import / not a config-built app.
  buildConfig         Json?
  /// Workspace model: parent app id when this is a sub-project (service) of an
  /// imported monorepo workspace. Null for standalone apps + the workspace itself.
  parentId            String?
  /// Sub-project directory within the parent repo (e.g. 'velvel-admin'). Null unless a child.
  servicePath         String?
  /// "Bộ site": id chung của các site được tạo cùng một lượt (website / CMS / portal / API).
  /// Khác `parentId` ở chỗ mọi thành viên đều là app ĐỘC LẬP — có site riêng, địa chỉ riêng,
  /// và vẫn hiện trong danh sách app (app con của workspace thì bị ẩn). Null = app đứng một mình.
  suiteId             String?
  /// Vai trò của app trong bộ: 'site' | 'cms' | 'portal' | 'api'. Null khi không thuộc bộ nào.
  surface             String?
  /// Site ĐẠI DIỆN của bộ — cái duy nhất hiện thành thẻ ở danh sách "Website của tôi"; các site
  /// còn lại nằm BÊN TRONG thẻ đó. Phải là một cột chứ không suy ra lúc chạy, vì danh sách app
  /// phân trang + đếm tổng ở tầng SQL: gom sau khi lấy trang về sẽ ra những trang thiếu thẻ và
  /// một con số tổng nói dối.
  suitePrimary        Boolean   @default(false)
  /// Pinned to the user's sidebar for quick access.
  pinned              Boolean   @default(false)
  /// Published to the public showcase (anyone can view the app's public page).
  published           Boolean   @default(false)
  /// Public-page visit counter (GitHub-style view count).
  visits              Int       @default(0)
  /// Remix loop: the app this one was forked from (null = original).
  remixedFromId       String?
  /// How many times this app has been remixed/forked by others.
  remixCount          Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  parent       App?          @relation("AppChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children     App[]         @relation("AppChildren")
  remixedFrom  App?          @relation("AppRemixes", fields: [remixedFromId], references: [id], onDelete: SetNull)
  remixes      App[]         @relation("AppRemixes")
  builds       Build[]
  deployments  Deployment[]
  blueprints   Blueprint[]
  serverDeploy ServerDeploy?
  members      AppMember[]
  visitDays    AppVisitDay[]
  automations  Automation[]
  listings     Listing[]

  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
  @@index([parentId])
  @@index([suiteId])
}

/// Per-app, per-day visit analytics — ONE row per (app, day), bucket counters
/// merged in JSON to bound row growth. Written by the public /track beacon that
/// deployed apps fire on load; read (aggregated) by the Analytics dashboard.
model AppVisitDay {
  id        String   @id @default(cuid())
  appId     String
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  /// UTC calendar day, "YYYY-MM-DD".
  day       String
  /// Total pageviews that day.
  count     Int      @default(0)
  /// { "<referrer-host>": count } — capped to the top entries.
  referrers Json?
  /// { "mobile": n, "desktop": n } device-class buckets.
  devices   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, day])
  @@index([appId])
}

/// A scheduled task for an app: the platform calls a PATH on the app's OWN
/// deployed URL every `intervalMinutes` (SSRF-safe — host is always the app's
/// public domain, never arbitrary). Runs from the API's in-process scheduler.
model Automation {
  id              String    @id @default(cuid())
  appId           String
  app             App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  name            String
  enabled         Boolean   @default(true)
  /// Run cadence in minutes (15, 60, 360, 1440=daily, 10080=weekly).
  intervalMinutes Int       @default(1440)
  /// HTTP method to call (GET/POST/...).
  method          String    @default("GET")
  /// Path on the app's own URL, e.g. "/api/cron/digest".
  path            String    @default("/")
  /// Optional JSON body for non-GET calls.
  body            String?   @db.Text
  nextRunAt       DateTime  @default(now())
  lastRunAt       DateTime?
  /// Last HTTP status (0 = never run / network error).
  lastStatus      Int       @default(0)
  lastError       String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([appId])
  @@index([enabled, nextRunAt])
}

model Build {
  id         String      @id @default(cuid())
  appId      String
  app        App         @relation(fields: [appId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  prompt     String      @db.Text
  name       String?
  track      Track?
  status     BuildStatus @default(queued)
  /// "codegen" (AI generates files) | "edit" (user-edited files, skip codegen)
  mode       String      @default("codegen")
  /// Per-build model choice: "opus" (5 credits) | "sonnet" (1 credit).
  model      String      @default("opus")
  /// Brand/accent color (`#rrggbb`) fed into codegen. Null when unset.
  primaryColor String?
  /// Preferred layout/canvas hint (e.g. "dashboard"|"landing"|"auto").
  style      String?     @default("auto")
  /// When the design stage runs, auto-approve the Blueprint instead of pausing
  /// at the gate. Default true; only the first design of a new app honours false.
  autoApprove Boolean    @default(true)
  /// Workflow preset (shared.BuildPreset): "turbo" (bỏ phân loại/thiết kế/đặc tả,
  /// sinh code thẳng từ yêu cầu) | "balanced" (chạy đủ quy trình, tự duyệt thiết kế)
  /// | "thorough" (dừng ở cổng duyệt thiết kế). Default "balanced" = hành vi hiện
  /// tại, nên mọi build cũ và mọi caller không truyền preset giữ nguyên quy trình.
  preset      String     @default("balanced")
  stages     Json        @default("[]")
  spec       String?     @db.Text
  /// Attached upload refs for the conversation: [{ id, name, kind, mime }].
  attachments Json       @default("[]")
  files      Json? // GeneratedFile[]
  /// Snapshot of the build/deploy config used for THIS build (shared.BuildConfig).
  /// Makes a deploy reproducible/rollbackable independent of later App.buildConfig
  /// edits. Null = none (codegen build or pre-feature import).
  buildConfig Json?
  logs       Json        @default("[]")
  result     Json? // BuildResult
  usage      Json? // TokenUsage
  /// Whether this build's REAL token usage (usage.input+output) has been metered
  /// into the owner's monthly quota (User.quotaUsed). Set true once, on SUCCESS only
  /// (failed/canceled builds are never metered) — guards against double-counting.
  /// Build này là lượt TỰ ĐỘNG chạy lại của build nào (null = do người dùng tạo).
  ///
  /// Vừa để chống lặp vô hạn — một lượt tự chạy lại KHÔNG được đẻ ra lượt nữa — vừa để nhìn ra
  /// dây chuyền khi soi lỗi: thấy hai build liền nhau cùng một yêu cầu thì biết ngay cái sau là
  /// máy tự chạy chứ không phải người dùng bấm hai lần.
  autoRetryOf String?

  metered    Boolean @default(false)
  /// [legacy] pre-paid credit fields — superseded by post-build token metering.
  creditsCharged Int     @default(0)
  creditWindowAt DateTime?
  error      String?     @db.Text
  /// Admin acknowledged this failed build in the error report (clears it from the
  /// default /admin/build-errors view). Does not change the build itself.
  errorReviewed Boolean  @default(false)
  createdAt  DateTime    @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  updatedAt  DateTime    @updatedAt

  deployment Deployment?
  blueprint  Blueprint?

  @@index([appId])
  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
}

// Versioned "design intake" produced before codegen and reviewed at the gate.
// One draft row per design build (`buildId` unique); promoted to `approved` when
// the user approves. `spec` holds the shared.Blueprint JSON payload.
model Blueprint {
  id         String    @id @default(cuid())
  appId      String
  app        App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  buildId    String?   @unique
  build      Build?    @relation(fields: [buildId], references: [id], onDelete: SetNull)
  version    Int       @default(1)
  status     String    @default("draft") // draft | approved | superseded
  spec       Json
  approvedAt DateTime?
  approvedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([appId])
}

model Deployment {
  id                String           @id @default(cuid())
  appId             String
  app               App              @relation(fields: [appId], references: [id], onDelete: Cascade)
  buildId           String           @unique
  build             Build            @relation(fields: [buildId], references: [id], onDelete: Cascade)
  url               String
  previewUrl        String?
  pagesProject      String
  pagesDeploymentId String?
  status            DeploymentStatus @default(live)
  createdAt         DateTime         @default(now())

  @@index([appId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  target     String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}

// Bank-transfer payment intent (SePay). A pending Payment carries a unique memo
// `code`; the SePay webhook matches an incoming transfer by `code` + amount and
// activates the user's plan. `sepayId` is the SePay transaction id (idempotency).
model Payment {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Với đơn mua GÓI: id gói. Với đơn mua DUNG LƯỢNG: giữ gói hiện tại của người dùng để lịch sử
  /// đọc được, còn thứ quyết định là `kind`.
  plan      String
  /// 'plan' (mặc định, mua/nâng gói) | 'storage' (mua thêm dung lượng theo tháng).
  /// Có trường này thì `settle()` biết phải cấp gì, thay vì đoán từ `plan`.
  kind      String    @default("plan")
  /// Số GB mua thêm — chỉ dùng khi kind = 'storage'.
  storageGb Int       @default(0)
  code      String    @unique
  amountVnd Int
  status    String    @default("pending") // pending | paid
  gateway   String?
  sepayId   String?   @unique
  createdAt DateTime  @default(now())
  paidAt    DateTime?
  // Upgrade-proration intent context: when `prorated`, amountVnd is only the
  // time-scaled price DIFFERENCE and settle() must KEEP the cycle (not grant a
  // fresh month). `cycleAnchorAt` = the user's quotaResetAt the proration was
  // priced against; settle re-validates it still matches before honoring the
  // upgrade, so a stale intent paid after the window changed can't over-grant.
  prorated     Boolean   @default(false)
  cycleAnchorAt DateTime?

  @@index([userId])
  @@index([code])
}

// Single-row platform configuration, edited from the admin CMS.
model Setting {
  id        String   @id @default("singleton")
  config    Json
  /// AES-256-GCM encrypted JSON of optional provider API keys { openai?, grok? }
  /// set from the admin "AI Keys" page. Services prefer these over env vars.
  aiKeysEnc String?
  /// AES-256-GCM encrypted JSON { botToken, botUsername?, webhookSecret } for the
  /// Telegram remote-run bot, set from the admin page (no redeploy). Env is the fallback.
  telegramEnc String?
  updatedAt DateTime @updatedAt
}

// "Deploy lên Server (Docker)" — one per app. Tracks a docker-compose deploy on
// the host: each service's public subdomain / port / URL. Inert feature unless
// SERVER_DEPLOY_* env is configured.
/// Per-user backup of the desktop Lark × Claude local data (chat sessions + bases +
/// settings) so it survives a lost machine + syncs across devices. The Lark
/// app_secret is NEVER backed up here — it stays local (OS keychain). `data` is the
/// opaque blob { sessions, bases, settings }; merge/conflict is handled client-side.
/// AI đang chịu trách nhiệm chạy lịch tự động hoá Lark cho người dùng này.
///
/// Cần vì lịch có thể chạy ở HAI nơi: app desktop, và một máy chạy nền (VM) kiểu tw-cms-keeper.
/// Không có chỗ chốt này thì mỗi lịch chạy hai lần — và với một lịch GHI dữ liệu, đó là hai bản
/// ghi trùng trong Base thật của khách, mỗi phút một cặp.
///
/// Luật: bên nào nhịp tim gần nhất trong 90 giây là chủ; khi cả hai còn sống thì VM thắng, vì đó
/// là nơi người dùng CỐ Ý đặt để chạy 24/7. Không giữ bí mật gì ở đây — chỉ là một cái tên máy.
/// Khoá Lark do NGƯỜI DÙNG CỐ Ý gửi lên để Larkwave chạy lịch tự động hoá 24/7 hộ họ.
///
/// Đây là chỗ DUY NHẤT trong hệ thống cất chất liệu khoá Lark, và nó tồn tại vì một đánh đổi
/// được cân nhắc rồi mới chọn: lịch tự động hoá chạy trên máy người dùng thì tắt app là chết,
/// mà phần lớn người dùng không có VM riêng để tự chạy. Hệ quả phải nói thẳng: runner chạy
/// không người trông, nên máy chủ phải giải mã được khoá KHÔNG CẦN người dùng có mặt — tức là
/// ai chiếm được máy chủ VÀ khoá kho thì mint được tenant token cho mọi tenant Lark đã bật.
/// Vì vậy:
///   • Chỉ ghi khi người dùng tự bật. Không bao giờ bật sẵn, không suy ra từ việc đã kết nối Lark.
///   • `secretEnc` mã bằng AES-256-GCM với khoá lấy từ env `LARK_CREDS_KEY` — CỐ Ý tách khỏi
///     `JWT_SECRET`, để lộ mình JWT_SECRET không mở được kho này.
///   • Không API nào trả `secretEnc` hay bản rõ về cho trình duyệt. Chỉ tiến trình runner đọc,
///     qua endpoint nội bộ chắn bằng `LARK_RUNNER_SERVICE_KEY`.
///   • Người dùng tắt là xoá hàng, không phải đánh dấu disabled.
model LarkHostedRunner {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// app_id của Lark custom app (không phải bí mật — hiện được ở giao diện).
  appId     String
  /// app_secret đã mã: "v1:<iv>:<tag>:<ciphertext>". KHÔNG BAO GIỜ rời máy chủ.
  secretEnc String
  /// Nhãn người đọc được, hiện ở chỗ "ai đang giữ quyền chạy lịch".
  label     String   @default("Larkwave chạy hộ")
  /// Lần cuối tiến trình runner thật sự nạp được tenant này.
  lastSeenAt DateTime?
  /// Lỗi gần nhất của tenant này (sai khoá, hết hạn…) — hiện cho người dùng tự sửa.
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model LarkRunnerLease {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Định danh máy tự sinh (không phải tên người dùng đặt) — chỉ để phân biệt hai bên.
  ownerId   String
  /// 'vm' | 'desktop'. Quyết định ai thắng khi cả hai cùng sống.
  ownerKind String
  /// Nhãn người đọc được, hiện ở giao diện ("VM seed-runner", "MacBook của Deveris").
  label     String   @default("")
  beatAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([beatAt])
}

model LarkBackup {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A PUBLICLY-shareable Lark × Agents conversation. The desktop uploads a sanitized
/// transcript (no app_secret / no Base app_tokens); the website renders it read-only
/// at /lark/s/<id>. `sourceId` = the local session id, so re-sharing UPDATES the same
/// link (upsert per user+source) instead of minting a new one each time.
/// A delegated Lark connection: the OWNER's desktop keeps the credential and executes
/// everything; a grantee only ever holds this row. There is deliberately NO secret column
/// here — SHARING never moves key material, so a stolen grant row cannot mint a Lark token.
/// The authoritative scope (app_token / table_id) lives on the owner's disk in
/// `${userData}/lark/grants.json`; this row carries only human-readable names.
///
/// CẨN TRỌNG (2026-09-12): câu trên từng đọc là "the server holds zero Lark key material".
/// Câu đó KHÔNG còn đúng cho toàn hệ thống kể từ khi có `LarkHostedRunner` — người dùng nào
/// bật chạy lịch 24/7 là cố ý gửi app_secret của họ lên đây. Bất biến còn lại chỉ hẹp đúng
/// phạm vi model này: chia sẻ không bao giờ chuyển khoá. Đừng suy ra từ đây rằng máy chủ
/// sạch khoá Lark — xem chú thích ở `LarkHostedRunner` để biết thứ thật sự được cất.
model LarkGrant {
  id        String  @id @default(cuid())
  ownerId   String
  owner     User    @relation("LarkGrantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  granteeId String?
  grantee   User?   @relation("LarkGrantGrantee", fields: [granteeId], references: [id], onDelete: SetNull)
  /// lark = share the owner's Lark connection (base-scoped); agentchat = share the general
  /// "Trợ lý AI" assistant (no base scope, always read-only). The server relay is identical
  /// for both — only the owner's desktop picks a different, kind-appropriate executor.
  kind      String  @default("lark")
  label     String  @default("")
  /// pending | active | suspended | revoked
  status    String  @default("pending")
  /// ask = read-only Q&A; build = writes allowed (each write still needs owner approval)
  mode      String  @default("ask")
  expiresAt DateTime?
  turnsPerHour   Int @default(60)
  turnsPerDay    Int @default(300)
  tokenBudgetPct Int @default(5)
  createdAt DateTime @default(now())
  revokedAt DateTime?
  lastUsedAt DateTime?

  invites LarkGrantInvite[]
  scopes  LarkGrantScopeRef[]
  calls   LarkGrantCall[]
  turns   LarkGrantTurn[]
  convs   LarkSharedConv[]

  @@index([ownerId])
  @@index([granteeId])
}

/// The invitation IS this row, keyed to one specific user — there is no code, link or
/// deep link anywhere, which removes the entire "invite leaked via URL/log/chat" class.
model LarkGrantInvite {
  id            String   @id @default(cuid())
  grantId       String
  grant         LarkGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  inviteeUserId String
  invitee       User      @relation(fields: [inviteeUserId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@unique([grantId, inviteeUserId])
  @@index([inviteeUserId])
}

/// Human-readable scope for display/audit only. NEVER an app_token — the enforcing copy
/// is on the owner's machine, so a compromised server cannot widen what a grant reaches.
model LarkGrantScopeRef {
  id         String   @id @default(cuid())
  grantId    String
  grant      LarkGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  baseName   String
  tableNames String[]

  @@index([grantId])
}

/// A turn a grantee asked the OWNER's desktop to run. The server never executes
/// anything: it queues the request, notifies the owner's device over the existing agent
/// SSE channel, and stores the result the desktop reports back.
model LarkGrantTurn {
  id         String    @id @default(cuid())
  grantId    String
  grant      LarkGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  /// Hội thoại dùng chung sinh ra lượt này, nếu có. Rỗng = lượt lẻ như trước (giữ tương thích).
  convId     String?
  actorId    String
  prompt     String    @db.Text
  /// queued | running | succeeded | failed | denied | canceled
  status     String    @default("queued")
  result     String?   @db.Text
  error      String?   @db.Text
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([grantId, createdAt])
  @@index([status])
}

/// Một HỘI THOẠI DÙNG CHUNG trong phạm vi một grant: chủ và người được chia sẻ cùng đọc, cùng
/// viết, cùng thấy kết quả agent.
///
/// Vì sao gắn vào `LarkGrant` chứ không đứng riêng: grant ĐÃ mang toàn bộ chính sách — ai được
/// vào, Base nào đọc được, Base nào ghi được, hạn mức bao nhiêu. Một hội thoại đứng riêng sẽ cần
/// bản sao của chính sách đó, và bản sao sẽ trôi lệch — lúc đó thứ chạy sai lại là quyền ghi.
///
/// Bất biến giữ nguyên: máy chủ KHÔNG chạy gì cả. Mọi lượt agent vẫn do máy của CHỦ thực thi qua
/// `LarkGrantTurn`; ở đây chỉ thêm phần ai-nói-gì để hai bên cùng nhìn một luồng.
model LarkSharedConv {
  id          String    @id @default(cuid())
  grantId     String
  grant       LarkGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  title       String    @default("")
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items LarkConvItem[]

  @@index([grantId, updatedAt])
}

/// Một dòng trong hội thoại dùng chung.
///
/// `seq` tăng dần trong phạm vi một hội thoại và có `@@unique` — đó là thứ giữ cho hai bên cùng
/// thấy MỘT thứ tự. Sắp xếp theo `createdAt` là không đủ: hai người gửi cùng lúc thì thứ tự hiện
/// ra ở mỗi máy có thể khác nhau, và một cuộc trò chuyện mà mỗi người đọc một thứ tự thì tệ hơn
/// không dùng chung.
model LarkConvItem {
  id         String         @id @default(cuid())
  convId     String
  conv       LarkSharedConv @relation(fields: [convId], references: [id], onDelete: Cascade)
  /// userId của người viết, hoặc chuỗi 'agent' cho câu trả lời của trợ lý.
  authorId   String
  authorName String         @default("")
  /// user | agent | system
  role       String         @default("user")
  text       String         @db.Text
  /// Lượt uỷ quyền sinh ra mục này, nếu có — để theo dõi nó đang chạy hay đã xong.
  turnId     String?
  seq        Int
  createdAt  DateTime       @default(now())

  @@unique([convId, seq])
  @@index([convId, seq])
}

/// One tool call made through a grant — the owner's per-person access log.
model LarkGrantCall {
  id             String   @id @default(cuid())
  grantId        String
  grant          LarkGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  actorId        String
  actor          User      @relation(fields: [actorId], references: [id], onDelete: Cascade)
  conversationId String?
  tool           String
  targetName     String   @default("")
  /// allowed | denied_scope | denied_rate | denied_owner | error
  decision       String
  latencyMs      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([grantId, createdAt])
  @@index([actorId])
}

model LarkShare {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId  String // the desktop's local Lark session id
  title     String   @default("")
  /// { items: ChatItem[], runner?, model?, createdAt? } — opaque render payload
  data      Json     @default("{}")
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sourceId])
  @@index([userId])
}

model ServerDeploy {
  id        String   @id @default(cuid())
  appId     String   @unique
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  status    String   @default("deploying") // deploying | live | failed
  /// [{ name, subdomain, port, url }]
  services  Json     @default("[]")
  log       String?  @db.Text
  error     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Daily AI-generated app-idea suggestions shown on the builder home. Each run is
// kept for history (admin); the most recent run is what users see.
model SuggestionRun {
  id        String   @id @default(cuid())
  /// [{ label, prompt, track? }]
  items     Json     @default("[]")
  count     Int      @default(0)
  model     String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Blog / content marketing posts. Public list+detail (SEO) at /blog; authored and
// managed by admins in aapp (/admin/blog). Body is Markdown rendered on the web.
/// Bình luận dưới một bài viết blog.
///
/// Vì sao KHÔNG dùng lại `SocialComment`: model đó gắn cứng vào `SocialPost` của trang Cộng đồng
/// (quan hệ bắt buộc, xoá bài là xoá bình luận). Ghép blog vào đó nghĩa là hai tính năng khác hẳn
/// nhau dùng chung một bảng và một bộ luật kiểm duyệt — đổi luật cho bên này là đổi luôn bên kia.
///
/// `status` có chủ ý mặc định là `visible` chứ không phải `pending`: một blog mà mọi bình luận
/// phải chờ duyệt thì thực tế là không có bình luận, vì không ai ngồi duyệt. Đổi lại phải có
/// đường gỡ nhanh — xem `hidden` và chỉ mục theo `status`.
model BlogComment {
  id        String   @id @default(cuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// Người viết. Bắt buộc đăng nhập — bình luận ẩn danh trên một blog công khai là mời spam.
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Tên hiển thị lúc viết, giữ lại để đổi tên sau không làm lệch lịch sử.
  authorName String  @default("")
  content   String   @db.Text
  /// Trả lời một bình luận khác. Chỉ MỘT cấp — lồng sâu trên blog là không ai đọc nổi.
  parentId  String?
  /// visible | hidden — `hidden` do admin gỡ hoặc tác giả tự xoá.
  status    String   @default("visible")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, status, createdAt])
  @@index([authorId])
}

model BlogPost {
  id          String   @id @default(cuid())
  /// URL-safe unique slug (/blog/:slug). Derived from title, dedup with a suffix.
  slug        String   @unique
  title       String
  /// Short summary for cards + meta description fallback.
  excerpt     String?  @db.Text
  /// Markdown body.
  content     String   @db.Text
  /// Cover/hero image URL (optional).
  coverImage  String?
  /// "draft" | "published".
  status      String   @default("draft")
  /// Chuyên mục CHÍNH — mỗi bài đúng một, là thứ dùng để chia tab trên /blog.
  /// Tách khỏi `tags` có chủ ý: trước đây hai khái niệm bị gộp làm một mảng, nên không có cách
  /// nào hỏi "các bài cùng chuyên mục" mà không đoán xem phần tử nào là chuyên mục.
  category    String?
  /// string[] — THẺ, mỗi bài nhiều thẻ. Dùng để lọc hẹp, không dùng để chia tab.
  tags        Json     @default("[]")
  /// SEO overrides (fall back to title/excerpt when null).
  seoTitle       String?
  seoDescription String? @db.Text
  /// Bản dịch theo ngôn ngữ: { "en": { title, excerpt, content, seoTitle, seoDescription }, ... }
  ///
  /// MỘT CỘT JSON chứ không phải thêm cột cho từng thứ tiếng (titleEn, contentEn…): thêm cột thì
  /// mỗi ngôn ngữ mới là một lần đổi schema kèm migrate; với object thì thêm tiếng Hàn chỉ là ghi
  /// thêm một khoá, không đụng cơ sở dữ liệu.
  ///
  /// Các cột gốc phía trên VẪN LÀ BẢN CHUẨN (đang giữ tiếng Việt); `i18n` chỉ chứa ngôn ngữ KHÁC.
  /// Nhờ vậy mã cũ đọc `post.title` vẫn chạy nguyên, không bài nào mất trong lúc chuyển đổi.
  i18n           Json     @default("{}")
  /// Author (admin User). Denormalised authorName survives author deletion.
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName  String?
  comments    BlogComment[]
  /// Whether to feature on the landing blog teaser.
  featured    Boolean  @default(false)
  views       Int      @default(0)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([featured, publishedAt])
}

/// One metered MAIC (Larkwave-hosted Claude) turn. `runId` (from MAIC) is the idempotency
/// key so a retry can't double-debit. `tokens` = costUsd converted via MAIC_USD_PER_MTOK and
/// is what gets added to User.quotaUsed (the % budget). Also an audit trail of hosted spend.
model MaicUsage {
  runId     String   @id
  userId    String
  costUsd   Float
  tokens    Int
  kind      String   // 'ask' | 'run' | 'lark'
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// Maps a client conversation id → MAIC's returned sessionId. MAIC is stateless per token,
/// so multi-turn memory requires resending its sessionId each turn; this is where we keep it.
model MaicSession {
  id                   String   @id @default(cuid())
  userId               String
  clientConversationId String
  maicSessionId        String
  /// Bối cảnh mang sang từ một lượt CÓ FILE ĐÍNH KÈM.
  ///
  /// Lượt có file chạy qua agentic run — một lượt chạy dùng một lần, KHÔNG có sessionId để nối
  /// lại (MaicRunResult chỉ có runId). Nên trước đây mọi thứ model đọc được từ file biến mất ngay
  /// ở tin nhắn kế tiếp: người dùng gửi ảnh PI, AI đọc đủ 14 dòng hàng, rồi lượt sau hỏi tiếp thì
  /// nó không còn biết gì. Ghi lại câu hỏi + câu trả lời của lượt đó ở đây và ghép vào lượt sau.
  carryOver            String?  @db.Text
  /// Hội thoại này đã chuyển sang chế độ agentic (có workspace + công cụ) và phải Ở LẠI đó.
  ///
  /// Người dùng đang giữa một công việc: gửi PI → "không cần form mẫu, hãy tự tạo" → xuất hợp
  /// đồng. Lượt giữa không đính kèm gì nên rơi về đường chữ thuần — nơi model VẪN gọi công cụ
  /// nhưng KHÔNG BAO GIỜ nhận được kết quả, và lượt chết ngay sau câu "Tôi kiểm tra môi trường
  /// làm việc trước.". Đã vào việc thì ở lại đường có công cụ cho tới hết hội thoại.
  agentic              Boolean  @default(false)
  lastUsedAt           DateTime @updatedAt

  @@unique([userId, clientConversationId])
  @@index([userId])
}

/// Sổ các lượt chạy MAIC ĐANG MỞ — tồn tại vì đúng một lý do: huỷ được chúng sau khi API
/// khởi động lại giữa chừng.
///
/// Huỷ một build chỉ cắt luồng sự kiện phía Larkwave; lượt chạy trên MAIC vẫn chạy tới hết
/// và vẫn đốt hạn ngạch DÙNG CHUNG của cả hệ thống. Với build bị huỷ, `runAgent` tự huỷ lượt
/// từ xa. Với build mồ côi do restart thì không còn ai giữ runId trong bộ nhớ nữa — bảng này
/// là chỗ duy nhất còn biết. Khi API khởi động, mọi hàng chưa đóng đều là mồ côi (chỉ đúng khi
/// API chạy MỘT tiến trình duy nhất — ci-deploy.sh đang bảo đảm điều đó).
model MaicRun {
  /// runId do MAIC cấp.
  id        String    @id
  /// Bề mặt gọi: codegen | agent | server-deploy — để đọc log biết cái gì bỏ lại rác.
  kind      String    @default("agent")
  userId    String?
  createdAt DateTime  @default(now())
  closedAt  DateTime?

  @@index([closedAt, createdAt])
}

/// Bài đăng trong "Cộng đồng" — dòng thời gian kiểu Threads: ai cũng đọc được, chủ bài tự xoá
/// được, quản trị xoá được mọi bài.
model SocialPost {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  /// Tệp đính kèm: mảng JSON [{url, name, mime, size}]. Ảnh hiện thành lưới, thứ khác thành thẻ
  /// tải về. Lưu URL chứ không lưu id upload: bài đăng là dữ liệu CÔNG KHAI và tồn tại lâu, nếu
  /// kho tệp đổi cách đánh id thì mọi bài cũ mất ảnh.
  attachments Json   @default("[]")
  createdAt DateTime @default(now())

  likes    SocialPostLike[]
  comments SocialComment[]

  @@index([createdAt])
  @@index([authorId])
}

/// Một lượt thích. Khoá chính ghép (bài, người) nên mỗi người chỉ thích được một lần — ràng buộc
/// nằm ở CSDL chứ không dựa vào giao diện.
model SocialPostLike {
  postId    String
  userId    String
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([postId, userId])
  @@index([userId])
}

model SocialComment {
  id        String     @id @default(cuid())
  postId    String
  authorId  String
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  /// Trả lời một bình luận khác. MỘT cấp duy nhất — nhắm vào một trả lời thì gắn lên cha của nó
  /// (xem community.service). Lồng sâu trên điện thoại là thụt lề mấy tầng, không ai đọc nổi.
  ///
  /// Quan hệ TỰ THAM CHIẾU có `onDelete: Cascade`: xoá một bình luận gốc là xoá luôn nhánh trả
  /// lời của nó — để lại thì chúng thành mồ côi, hiện lơ lửng không rõ đang trả lời ai.
  parentId  String?
  parent    SocialComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   SocialComment[] @relation("CommentReplies")
  createdAt DateTime   @default(now())

  @@index([postId, createdAt])
  @@index([parentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CỬA HÀNG — giai đoạn 2: danh mục về ở đây, thôi đọc nhờ portal
//
// Kế hoạch đầy đủ: docs/hop-nhat-cua-hang-va-nen-tang.md. Ba quyết định đã chốt ngày
// 24/09/2026, ghi ở đây vì chúng nhìn từ lược đồ mới thấy được:
//
//  1. ĐƯỜNG GIAO HÀNG (driveLink, zipFileUrl, gitlabRepoId) nằm ở cột MÃ HOÁ riêng, KHÔNG nằm
//     trong `detail`. Mục 4 của kế hoạch bỏ quên chúng, và chỗ duy nhất "tiện" để nhét là
//     `detail` — nhưng `detail` đi thẳng ra API công khai, nên nhét vào đó là mở lại đúng lỗ rò
//     vừa bịt bên portal hôm 23/09. Tách cột là thứ khiến lỗi đó không thể tái diễn do sơ ý.
//  2. `slug` duy nhất THEO TỪNG LOẠI, không duy nhất toàn cục: đường dẫn đang chạy thật là
//     /store/<kind>/<slug>, nên hai loại hàng trùng slug vẫn ra hai trang khác nhau.
//  3. Giá là Int VND, không Decimal — khớp `Payment.amountVnd` và phần còn lại của lược đồ.
//     Portal trả Decimal ra JSON dạng CHUỖI ("100000.00"), script nhập làm tròn khi chuyển.
// ─────────────────────────────────────────────────────────────────────────────

/// Một món bán được. MỘT bảng cho mọi loại hàng — trang bán, tìm kiếm, SEO và quản trị đều nhìn
/// mọi món như nhau; phần khác nhau giữa các loại nằm gọn trong `detail`.
model Listing {
  id               String    @id @default(cuid())
  /// shared.StoreKind: software | document | sourcecode | app | tool | service.
  kind             String
  slug             String
  name             String
  descriptionShort String?   @db.Text
  description      String?   @db.Text
  thumbnailUrl     String?   @db.Text
  /// string[] — ảnh phụ của trang bán.
  gallery          Json?
  priceVnd         Int       @default(0)
  /// Giá gạch ngang để so sánh. Null = không khuyến mãi.
  compareAtVnd     Int?
  category         String?
  /// active | hidden | sold_out. `hidden` KHÔNG xoá dữ liệu — đơn hàng cũ vẫn phải đọc được tên
  /// và giá của món đã bán.
  status           String    @default("active")
  sortOrder        Int       @default(0)
  totalSold        Int       @default(0)
  /// shared.StoreListingDetail — languages, version, prerequisites, specDocument, fileType…
  /// CHỈ chứa thứ được phép ra ngoài: cột này đi thẳng ra API công khai.
  detail           Json?
  /// shared.AppSeo — tiêu đề/mô tả/ảnh riêng cho trang bán, sửa được từ CMS.
  /// Null = suy ra từ `name` + `descriptionShort`.
  seo              Json?
  /// ĐƯỜNG GIAO HÀNG, mã hoá AES-256-GCM (cùng cơ chế với `App.secretsEnc`):
  /// { driveLink?, zipFileUrl?, gitlabRepoId? }. Chỉ bộ giao hàng giải mã; không có đường nào đi
  /// ra API công khai. Xem chú thích số 1 ở đầu khối.
  deliveryEnc      String?   @db.Text
  /// Ghi chú nội bộ của quản trị. Không bao giờ ra ngoài.
  notesInternal    String?   @db.Text
  /// Với kind=app|tool: App của nền tảng đứng sau món này.
  appId            String?
  app              App?      @relation(fields: [appId], references: [id], onDelete: SetNull)
  /// Bản build ĐÓNG BĂNG được bán — người mua hôm nay và tháng sau nhận cùng một thứ.
  buildId          String?
  /// Null = Larkwave bán. Có giá trị = người dùng bán (chưa mở, xem mục 12 của kế hoạch).
  sellerId         String?
  seller           User?     @relation("ListingSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  /// Id bên hệ B, để script nhập chạy được NHIỀU LẦN mà không nhân đôi bản ghi.
  legacyId         String?
  /// Ngày sửa THEO NGUỒN (hệ B), khác với `updatedAt` là ngày bản ghi này được ghi ở hệ A.
  ///
  /// Phải có cột riêng vì `updatedAt` mang `@updatedAt`: Prisma đặt lại nó ở MỌI lượt ghi, nên
  /// sau một đợt nhập thì cả 209 dự án cùng mang một ngày. Hậu quả không phải chuyện thẩm mỹ —
  /// mục sắp xếp "Mới cập nhật" thành vô nghĩa, và `lastmod` trong sitemap khai với máy tìm kiếm
  /// rằng toàn bộ danh mục vừa đổi cùng lúc, đúng kiểu tín hiệu khiến nó bớt tin những lần sau.
  ///
  /// Null = món sinh ra ở hệ A (chưa từng qua nhập), lúc đó `updatedAt` mới là ngày thật.
  sourceUpdatedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  inventory    Inventory[]
  orderItems   OrderItem[]
  entitlements Entitlement[]

  @@unique([kind, slug])
  @@unique([kind, legacyId])
  @@index([kind, status])
  @@index([category])
  @@index([appId])
}

/// Một suất hàng có hạn — tài khoản phần mềm hoặc khoá bản quyền. Chỉ kind=software dùng tới;
/// tài liệu và mã nguồn bán bản sao nên không có khái niệm hết hàng.
model Inventory {
  id          String     @id @default(cuid())
  listingId   String
  listing     Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  /// Nội dung suất hàng (tài khoản/mật khẩu hoặc khoá), mã hoá AES-256-GCM.
  /// Hệ B lưu cột này ở dạng CHỮ THƯỜNG; mã hoá khi nhập là việc bắt buộc, không phải tuỳ chọn.
  dataEnc     String     @db.Text
  /// available | reserved | sold
  status      String     @default("available")
  orderItemId String?    @unique
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  soldAt      DateTime?
  legacyId    String?    @unique
  createdAt   DateTime   @default(now())

  @@index([listingId, status])
}

/// Đơn hàng — NHIỀU món một đơn. Hệ B gắn productType/productId thẳng vào đơn nên một đơn chỉ
/// mua được một thứ; khi bán app kèm tài liệu kèm gói hỗ trợ thì đó là hạn chế thật.
model Order {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalVnd  Int      @default(0)
  /// pending | paid | cancelled | refunded
  status    String   @default("pending")
  /// Ý định thanh toán bên `Payment` (kind='order'). Null với đơn do quản trị cấp tay.
  paymentId String?
  /// Đơn do nhân viên cấp thẳng vào tài khoản khách — ai cấp, và vì sao.
  grantedBy String?
  grantNote String?  @db.Text
  /// Id đơn bên hệ B, cho lần nhập lịch sử.
  legacyId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([userId, createdAt])
  @@index([status])
}

/// Một dòng hàng. `nameSnapshot`/`priceVnd` là BẢN CHỤP lúc mua: món có thể đổi tên hoặc đổi giá
/// sau đó, còn hoá đơn thì không được đổi theo.
model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId    String?
  listing      Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  kind         String
  nameSnapshot String
  priceVnd     Int      @default(0)
  qty          Int      @default(1)
  createdAt    DateTime @default(now())

  inventory   Inventory?
  fulfillment Fulfillment?

  @@index([orderId])
  @@index([listingId])
}

/// Việc giao một dòng hàng. Mỗi bước ghi một mốc vào `steps` để người mua tự theo dõi và quản trị
/// tự soi — thất bại phải DỪNG ở đúng bước, không nuốt lỗi.
model Fulfillment {
  id          String    @id @default(cuid())
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  /// reveal_secret | download | git_invite | app_handover | entitlement | manual
  method      String
  /// pending | running | delivered | failed
  status      String    @default("pending")
  /// Thứ người mua nhận được: link tải, tên repo, URL app, id app đã nhân bản…
  payload     Json?
  /// Mốc tiến trình: [{ buoc, luc, ok, ghiChu? }]
  steps       Json?
  error       String?   @db.Text
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

/// Quyền đã mua, tách khỏi đơn để kiểm tra cho rẻ: hỏi "người này có quyền X không" không phải
/// duyệt lại toàn bộ lịch sử đơn hàng.
model Entitlement {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sourcecode | tool_premium | app_license | subscription
  kind      String
  listingId String?
  listing   Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  /// App đã nhân bản vào tài khoản người mua, nếu có.
  appId     String?
  /// Đơn sinh ra quyền này. Null = quản trị cấp tay.
  orderId   String?
  grantedBy String?
  /// Null = vĩnh viễn.
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, kind, listingId])
  @@index([userId])
  @@index([listingId])
}
