{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": [
      "ES2021"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "electron"
    ],
    "paths": {
      "@larkwave/core": [
        "../../packages/core/src/index.ts"
      ],
      "@larkwave/shared": [
        "../../packages/shared/src/index.ts"
      ]
    },
    "allowJs": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "main",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
