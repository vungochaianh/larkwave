{
  "name": "@larkwave/desktop",
  "version": "0.1.5",
  "private": true,
  "description": "Larkwave desktop (Nextron) — Lark × Agents + Trợ lý AI chạy trên CLI AI của máy (Claude/Codex/Gemini/Grok).",
  "author": "Larkwave",
  "main": "app/background.js",
  "scripts": {
    "dev": "ELECTRON_RUN_AS_NODE= nextron",
    "dist": "nextron build",
    "dist:mac": "nextron build --mac",
    "dist:win": "nextron build --win",
    "typecheck:desktop": "tsc -p tsconfig.json --noEmit && tsc -p renderer/tsconfig.json --noEmit",
    "lint": "echo \"(desktop) no lint\""
  },
  "dependencies": {
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@babel/runtime-corejs3": "^7.26.0",
    "@larkwave/core": "workspace:*",
    "@larkwave/ui": "workspace:*",
    "electron-serve": "^1.3.0",
    "imapflow": "1.3.0",
    "nodemailer": "10.0.13",
    "zca-js": "2.2.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.6.1",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "antd": "5.29.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "next": "^15.5.0",
    "nextron": "^9.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5.7.3"
  }
}
