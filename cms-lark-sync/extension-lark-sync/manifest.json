{
  "manifest_version": 3,
  "name": "Lark Sync Helper",
  "version": "1.0.0",
  "description": "Auto-capture Lark Bitable connector cURL, quick-create sync jobs",
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "activeTab",
    "cookies"
  ],
  "host_permissions": [
    "https://*.larksuite.com/*",
    "https://*.feishu.cn/*",
    "https://apihoanam.toolswave.net/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.larksuite.com/*",
        "https://*.feishu.cn/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.larksuite.com/*",
        "https://*.feishu.cn/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://cmshoanam.toolswave.net/*",
      "http://localhost:8080/*"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
