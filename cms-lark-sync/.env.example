# ── API ─────────────────────────────────────────────────────────────────────
# Base URL for the backend REST API (no trailing slash)
NEXT_PUBLIC_API_BASE=https://apihoanam.toolswave.net/api

# Public URL of this Next.js app — used to build the Lark OAuth redirect URI.
# Local dev:  http://localhost:8080
# Production: https://cms.toolswave.net
NEXT_PUBLIC_APP_URL=https://cms.toolswave.net

# ── Claude AI (for Base Designer AI feature) ──────────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Lark OAuth (optional — can also be set in browser UI) ────────────────────
# Your Lark app credentials (also configurable in the Base Designer UI)
LARK_APP_ID=
LARK_APP_SECRET=

# ── Cloudinary (optional — for image upload feature) ─────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
